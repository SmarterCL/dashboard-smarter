# =============================================================================
# SmarterOS Web — Variables de entorno
# =============================================================================
# Copia este archivo a .env.local y completa los valores.
# NUNCA commitear .env.local — está en .gitignore.
#
# Reglas de seguridad:
#   NEXT_PUBLIC_*  → llega al browser. Solo datos no sensibles.
#   Sin prefijo    → solo server-side. NUNCA exponer al cliente.
#   SERVICE_ROLE_KEY / API_KEY / SECRET → secretos de infraestructura.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────────────────────────────────────
# Proyecto: https://supabase.com/dashboard/project/TU_PROJECT_ID
# Settings → API

# URL pública del proyecto (misma para browser y servidor)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co

# Clave pública (anon/publishable) — llega al browser, protegida por RLS
# Nombre legacy (dashboard-smarter):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nombre alternativo (Smarter-CRM) — el código acepta cualquiera de los dos:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service Role Key — SOLO server-side (lib/supabase.ts, bypass RLS)
# NUNCA usar en componentes "use client" ni NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# URL alternativa servidor (legacy lib/supabase.ts)
# Si no se define, se usa NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# URL CANÓNICA DEL SITIO
# ─────────────────────────────────────────────────────────────────────────────
# Usada en: links de email, redirects OAuth, callbacks de Gmail, headers CORS
# En desarrollo local: http://localhost:3000
# En producción: https://tudominio.com (sin trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─────────────────────────────────────────────────────────────────────────────
# CHATWOOT — Provisioning y runtime
# ─────────────────────────────────────────────────────────────────────────────
# Instancia Chatwoot donde se crean los agentes y conversaciones de los tenants.

# URL base de Chatwoot (ej: https://chat.smarterbot.store)
CHATWOOT_BASE_URL=

# ID de la cuenta administradora en Chatwoot
CHATWOOT_ACCOUNT_ID=

# ID de la bandeja (inbox) donde se crean contactos de soporte
CHATWOOT_INBOX_ID=

# API Token de administrador — SECRETO SERVER-SIDE
# Nombre Smarter-CRM (usado por lib/services/chatwoot-provisioning-service.ts):
CHATWOOT_API_TOKEN=
# Nombre dashboard-smarter legacy (usado por lib/services/chatwoot-service.ts):
# El código acepta cualquiera de los dos: CHATWOOT_API_TOKEN || CHATWOOT_API_ACCESS_TOKEN
CHATWOOT_API_ACCESS_TOKEN=

# Variables públicas para construir URLs de la bandeja en el browser
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chat.smarterbot.store
NEXT_PUBLIC_CHATWOOT_ACCOUNT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# CHATWOOT WIDGET — Soporte en la landing page
# ─────────────────────────────────────────────────────────────────────────────
# Website Token del widget de soporte (NO es el API token de admin)
# Es un identificador público — va en el browser (NEXT_PUBLIC_*)
# Obtener en: Chatwoot → Settings → Inboxes → Widget → Token
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# WAHA — WhatsApp HTTP API
# ─────────────────────────────────────────────────────────────────────────────
# Instancia WAHA que gestiona las sesiones de WhatsApp de los tenants.

# URL base del servidor WAHA (ej: https://waha.smarterbot.store)
WAHA_BASE_URL=

# API Key de WAHA — SECRETO DE INFRAESTRUCTURA
# Solo existe en: /root/secrets/waha.env (VPS) y esta variable server-side
# NUNCA usar en NEXT_PUBLIC_*, React, logs, respuestas JSON, Git
WAHA_API_KEY=

# Prefijo de sesión para el modelo multi-tenant (legacy dashboard-smarter)
# Default si no se define: "smarteros" → sesiones como "smarteros-{workspaceId}"
# Dejar vacío para usar "default" (sesión única, no multi-tenant)
WAHA_SESSION_PREFIX=smarteros

# URL base del servidor QR externo (infraestructura existente)
# NO se genera QR base64 desde Next.js — el QR vive en esta infraestructura
# Formato: {WAHA_QR_BASE_URL}/{waha_session_id}
# Ejemplo: https://qr.smarterbot.store/SmarterOS
WAHA_QR_BASE_URL=https://qr.smarterbot.store


# ─────────────────────────────────────────────────────────────────────────────
# GMAIL OAUTH — Canal de correo por tenant
# ─────────────────────────────────────────────────────────────────────────────
# OAuth2 SEPARADO del login Google de Supabase.
# El login de Supabase (Google) pide solo "email profile".
# Este OAuth pide permisos de Gmail para leer/enviar correos.
#
# Crear en: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Tipo: Web application
# Redirect URI autorizado: {NEXT_PUBLIC_SITE_URL}/api/gmail/callback
# Scopes: gmail.readonly, gmail.send, gmail.modify, userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# HERMES — Plano de orquestación (preparado, no activo todavía)
# ─────────────────────────────────────────────────────────────────────────────
# Hermes es el plano de agentes/orquestación separado del CRM web.
# Cuando esté disponible, descomentar y configurar.
#
# Arquitectura:
#   CRM Web → Supabase → Hermes API → Hermes VPS/Local → MCP → WAHA/n8n/Chatwoot
#
# HERMES_API_KEY es SECRETO SERVER-SIDE — nunca NEXT_PUBLIC_*
# El browser solo recibe: hermes_id, environment, health, capabilities (display)
#
# HERMES_API_URL=https://hermes.smarterbot.store
# HERMES_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# DOCKER / INFRA (opcional — solo para deployments con Docker)
# ─────────────────────────────────────────────────────────────────────────────
# next.config.mjs tiene output: "standalone" comentado.
# Habilitar si se usa Docker para producción.
# No requiere variables adicionales — se configura en next.config.mjs.


# =============================================================================
# RESUMEN DE VARIABLES POR ENTORNO
# =============================================================================
#
# DESARROLLO LOCAL (mínimo funcional):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# PRODUCCIÓN CON CHATWOOT + WAHA:
#   + CHATWOOT_BASE_URL, CHATWOOT_ACCOUNT_ID, CHATWOOT_INBOX_ID
#   + CHATWOOT_API_TOKEN (o CHATWOOT_API_ACCESS_TOKEN)
#   + NEXT_PUBLIC_CHATWOOT_BASE_URL, NEXT_PUBLIC_CHATWOOT_ACCOUNT_ID
#   + WAHA_BASE_URL, WAHA_API_KEY
#   + WAHA_QR_BASE_URL (default: https://qr.smarterbot.store)
#
# PRODUCCIÓN CON GMAIL:
#   + GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#
# PRODUCCIÓN CON WIDGET DE SOPORTE:
#   + NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN
#
# PRODUCCIÓN CON HERMES:
#   + HERMES_API_URL, HERMES_API_KEY (descomentar sección Hermes arriba)
#
# =============================================================================
